<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageProjectUrl>https://github.com/panoramicdata/LogicMonitor.Api/</PackageProjectUrl>
    <PackageLicenseUrl></PackageLicenseUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>LogicMonitor API REST</PackageTags>
    <Title>LogicMonitor.Api</Title>
    <Description>A .NET API for LogicMonitor</Description>
    <Summary>A .NET API for LogicMonitor</Summary>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <LangVersion>latest</LangVersion>
    <AnalysisMode>All</AnalysisMode>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/panoramicdata/LogicMonitor.Api/</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationIcon>LogicMonitor.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	<!-- Update the following before releasing to nuget -->
	<PackageReleaseNotes>
		v3.240.88:
		- Fixed: LogicMonitor has begun returning a role privilege objectType of "agentic", which
		  PrivilegeObjectType did not define. The enum carries a plain StringEnumConverter, which
		  throws on an unrecognised value rather than tolerating it, so a single unknown privilege on
		  a single role failed the entire roles or users response. Every caller reading roles or
		  users failed, whether or not it needed that privilege. PrivilegeObjectType now defines
		  Agentic.
		- Fixed: Role did not model the tenantIdentifier field LogicMonitor now returns on every
		  role. Debug builds set MissingMemberHandling.Error, so the response failed to deserialize
		  at the first role, before reaching any privilege; release builds ignore unmodelled members
		  and were unaffected. Role now carries TenantIdentifier.
	</PackageReleaseNotes>
    <UserSecretsId>57aaa0e7-815d-4065-9339-f3f070bed01e</UserSecretsId>
    <PackageId>LogicMonitor.Api</PackageId>
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="LogicMonitor.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Nerdbank.GitVersioning">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="Icon.png" Pack="true" PackagePath="" />
    <Folder Include="Properties\" />
  </ItemGroup>
</Project>