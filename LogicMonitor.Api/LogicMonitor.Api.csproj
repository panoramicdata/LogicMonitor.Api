<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageProjectUrl>https://github.com/panoramicdata/LogicMonitor.Api/</PackageProjectUrl>
    <PackageLicenseUrl></PackageLicenseUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>LogicMonitor API REST</PackageTags>
    <Title>LogicMonitor.Api</Title>
    <Description>A .NET API for LogicMonitor</Description>
    <Summary>A .NET API for LogicMonitor</Summary>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <LangVersion>latest</LangVersion>
    <AnalysisMode>All</AnalysisMode>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/panoramicdata/LogicMonitor.Api/</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationIcon>LogicMonitor.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	<!-- Update the following before releasing to nuget -->
	<PackageReleaseNotes>
		v3.240.90:
		- Fixed: several responses carried fields this client did not model, which fails the WHOLE
		  response in a Debug build because MissingMemberHandling.Error is set there. Release builds
		  ignore unmodelled members and were unaffected, so this restores the ability to test rather
		  than changing runtime behaviour. Found by sweeping live portal responses against the
		  models, endpoint by endpoint, rather than one failure at a time.
		- Reports: AlertsReport gains isEscalation, isIncludeDeletedResourceOrWebsite, logPartition
		  and suppressionType. ServerCpuReport, ResourceInventoryReport, ResourceMetricTrendsReport,
		  InterfaceBandwidthReport and SlaReport gain propertyFilterMetric, modelled by the new
		  PropertyFilterMetric type. ResourceGroupInventoryReport and InterfaceBandwidthReport gain
		  columns.
		- Dashboards: AlertWidgetFilter and ParsedAlertFilters gain suppressionType and
		  isIncludeDeletedResourceOrWebsite; a widget carries both under filters and parsedFilters,
		  so both types needed them. NocWidget gains displayClearedAlert.
		- ResourceGroup gains tenantIdentifier, the same field Role gained in 3.240.88.
		- Collector gains archType, cpAgent, logCollectorGroupId and logCollectorGroupName.
		- Swept and found complete, so unchanged: Alert, Resource, ScheduledDownTime, and all
		  twenty widget types other than NocWidget. LogicModules and netscans were not swept.
		  Websites were not either, and will not be: LogicMonitor has retired them for new portals,
		  where the same things appear as services or resources instead.
	</PackageReleaseNotes>
    <UserSecretsId>57aaa0e7-815d-4065-9339-f3f070bed01e</UserSecretsId>
    <PackageId>LogicMonitor.Api</PackageId>
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="LogicMonitor.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Nerdbank.GitVersioning">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="Icon.png" Pack="true" PackagePath="" />
    <Folder Include="Properties\" />
  </ItemGroup>
</Project>