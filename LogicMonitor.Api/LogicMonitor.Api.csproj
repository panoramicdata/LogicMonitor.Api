<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageProjectUrl>https://github.com/panoramicdata/LogicMonitor.Api/</PackageProjectUrl>
    <PackageLicenseUrl></PackageLicenseUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>LogicMonitor API REST</PackageTags>
    <Title>LogicMonitor.Api</Title>
    <Description>A .NET API for LogicMonitor</Description>
    <Summary>A .NET API for LogicMonitor</Summary>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <LangVersion>latest</LangVersion>
    <AnalysisMode>All</AnalysisMode>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/panoramicdata/LogicMonitor.Api/</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationIcon>LogicMonitor.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	<!-- Update the following before releasing to nuget -->
	<PackageReleaseNotes>
		v3.240.60:
		- Fixed: an unrecognised LogicModule type no longer deserialises to LogicModuleType.All, the
		  value that means "every type" when querying. A type this client did not model was therefore
		  indistinguishable from a deliberate no-filter, so a caller grouping by Type either dropped
		  those modules or filed them under a heading that means nothing, with nothing to indicate
		  anything was missing. TolerantStringEnumConverter already resolved an unmatched value to a
		  member named Unknown and fell back to All only in its absence; LogicModuleType now has one.
		  The converter itself is unchanged, and All remains 0, so the no-filter sentinel and
		  default(LogicModuleType) are unaffected for existing callers.
		- Added: LogicModuleType.RemediationSource, for LogicMonitor's remote action modules - Kill
		  Windows Process, Restart Linux Device, Microsoft Windows Disk Cleanup, Suspend and Resume
		  Windows Server Cluster Node and similar. The wire value is REMEDIATIONSOURCE, not the
		  ACTIONSOURCE the module names suggest. On one live portal nine such modules were landing on
		  All, out of 4,234 returned by setting/logicmodules/metadata.
	</PackageReleaseNotes>
    <UserSecretsId>57aaa0e7-815d-4065-9339-f3f070bed01e</UserSecretsId>
    <PackageId>LogicMonitor.Api</PackageId>
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="LogicMonitor.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Nerdbank.GitVersioning">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="Icon.png" Pack="true" PackagePath="" />
    <Folder Include="Properties\" />
  </ItemGroup>
</Project>